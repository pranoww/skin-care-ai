# --- AI provider ---------------------------------------------------------------
# google_genai (Gemini) or groq work out of the box. Other LangChain providers
# work after `uv add langchain-<provider>` plus LLM_MODEL / LLM_API_KEY.
LLM_PROVIDER=groq

# Key: LLM_API_KEY, or the provider's usual variable (GROQ_API_KEY / GEMINI_API_KEY)
GROQ_API_KEY=
# GEMINI_API_KEY=

# Models are optional; these are the per-provider defaults.
#   groq:         LLM_MODEL=openai/gpt-oss-120b  LLM_FALLBACK_MODEL=openai/gpt-oss-20b
#                 LLM_STT_MODEL=whisper-large-v3-turbo  (no server TTS; browser voice is used)
#   google_genai: LLM_MODEL=gemini-3.8-flash  LLM_STT_MODEL=gemini-3.5-flash
#                 LLM_TTS_MODEL=gemini-3.8-flash-tts  LLM_TTS_VOICE=Kore
# LLM_MODEL=
# LLM_FALLBACK_MODEL=
# LLM_STT_MODEL=

# --- Budget controls ----------------------------------------------------------
# Extra SDK retries after the first attempt (0 = one request). Same meaning for every provider.
LLM_MAX_RETRIES=0
LLM_TIMEOUT_SECONDS=60
# Retries only when the provider is overloaded (500/502/503). Quota errors (429) are never retried.
LLM_OVERLOAD_RETRIES=2
LLM_OVERLOAD_BACKOFF_SECONDS=2
# Use the browser's free speech transcript instead of a server transcription call.
USE_CLIENT_TRANSCRIPT=true
# Server speech synthesis (Gemini only). Defaults: on for Gemini, off otherwise.
# TTS_ENABLED=false

# --- HTTP ---------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
